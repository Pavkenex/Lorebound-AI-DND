# Build context is the repo root (docker compose build / Coolify): keep VCS
# state, secrets, venvs and node_modules out of the image build.
.git
.github
.worktrees
.ruff_cache
.env
**/__pycache__
**/.pytest_cache
**/.venv
**/node_modules
**/*.egg-info
# Next.js build output and TS build info belong to the frontend image only —
# the backend build (repo-root context) must not ship tens of MB of them.
**/.next
**/*.tsbuildinfo
backend/lorebound.db
